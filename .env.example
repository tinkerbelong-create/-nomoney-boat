# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...        # ingest ワーカー専用。ブラウザに出さないこと

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# ---- ingest ワーカー ----
# 公式サイトへのアクセスマナー。連絡先URLは必ず自分のものに書き換えること。
INGEST_USER_AGENT=NoMoneyBoat/0.1 (hobby fan site; +https://example.com/about)
INGEST_INTERVAL_MS=1200

# ---- 画面表示 ----
# 結果の反映にかかる最大時間（分）。GitHub Actions の実行間隔に合わせる。
NEXT_PUBLIC_SETTLE_DELAY_MIN=15
