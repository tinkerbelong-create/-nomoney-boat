m","w":"主:鳴門","k":"渦潮鯛","d":"渦の中心にしかいない。渦が消えると一緒に消える。"},{"n":"マンマルガメ","s":10,"c":"その他","f":"turtle","a":"#908068","b":"#d8c8b0","m":"swim","w":"主:丸亀","k":"真丸亀","d":"甲羅が完全な円。うちわのように水を煽いで進む。"},{"n":"アイゾメオオエイ","s":10,"c":"魚","f":"ray","a":"#2f4f80","b":"#5d7dae","m":"swim","w":"主:児島","k":"藍染大鱏","d":"通ったあとの海が藍色に染まる。児島のデニムはここから始まった。"},{"n":"オオトリイガキ","s":10,"c":"貝","f":"shell","a":"#ad976d","b":"#ebd5ab","m":"crawl","w":"主:宮島","k":"大鳥居牡蠣","d":"大鳥居の柱に張り付いて、鳥居の形に育ってしまった牡蠣。"},{"n":"ヤコウオオイカ","s":10,"c":"頭足","f":"squid","a":"#1d3c53","b":"#7998af","m":"swim","w":"主:徳山","k":"夜光大烏賊","d":"周南の工場の光を体に映して泳ぐ。"},{"n":"ガンリュウフグ","s":10,"c":"魚","f":"puffer","a":"#17364d","b":"#69889f","m":"swim","w":"主:下関","k":"巌流河豚","d":"二本の棘を刀のように構える。巌流島の沖にいる。"},{"n":"ワカマツモ","s":10,"c":"海藻","f":"weed","a":"#658c49","b":"#9bc27f","m":"fix","w":"主:若松","k":"若松藻","d":"松の形をした赤い海藻。死の海と呼ばれた洞海湾が甦った証。"},{"n":"アシワケアコウ","s":10,"c":"魚","f":"fish","a":"#1c3b52","b":"#64839a","m":"swim","w":"主:芦屋","k":"葦分赤魚","d":"遠賀川の葦をかき分けて現れる、真っ赤なアコウ。"},{"n":"ハカタオリサバ","s":10,"c":"魚","f":"fish","a":"#38576e","b":"#628198","m":"swim","w":"主:福岡","k":"博多織鯖","d":"体に博多織の献上柄が浮かぶ。街の真ん中の水面に出る。"},{"n":"ヒキヤマイカ","s":10,"c":"頭足","f":"squid","a":"#37566d","b":"#7594ab","m":"swim","w":"主:唐津","k":"曳山烏賊","d":"唐津くんちの曳山そのものの姿をした、呼子の巨大烏賊。"},{"n":"コトノウミリュウ","s":10,"c":"魚","f":"fish","a":"#39586f","b":"#6d8ca3","m":"swim","w":"主:大村","k":"琴海龍","d":"大村湾の古名は「琴の海」。日本で最初の水面の主。"}]